# Required: your free Google AI Studio API key for generation
# Get one at https://aistudio.google.com/apikey (no credit card required)
GOOGLE_API_KEY=AIza...

# Optional: protect the API itself with a shared secret (sent as X-API-Key header)
APP_API_KEY=

# --- Model settings (defaults shown) ---
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# --- Retrieval ---
RETRIEVAL_TOP_K=4
COLLECTION_NAME=company_knowledge_base
MAX_HISTORY_TURNS=6

# --- Paths (defaults relative to project root) ---
# DOCUMENTS_DIR=data/documents
# VECTORSTORE_DIR=data/vectorstore
